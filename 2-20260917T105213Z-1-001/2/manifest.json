
{
  "manifest_version": 3,
  "name": "Draft Opener",
  "version": "1.0",
  "description": "Opens all Facebook Marketplace listing drafts in new tabs.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["https://www.facebook.com/marketplace/you/selling*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
