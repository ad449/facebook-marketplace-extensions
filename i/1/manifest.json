{
  "manifest_version": 3,
  "name": "Facebook Marketplace Autofill",
  "version": "1.0",
  "description": "Auto-fill Title, Price, Description, and Images for Facebook Marketplace listings.",
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": ["https://www.facebook.com/marketplace/create/item*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/marketplace/create/item*"],
      "js": ["content.js"]
    }
  ]
}
