{
  "manifest_version": 3,
  "name": "FB Multi-Tab Location Clicker",
  "version": "1.0",
  "description": "Clicks first location option on all open tabs.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  }
}
